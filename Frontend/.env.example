# ─── BrandSetu Frontend — Production Environment ─────────────
# Copy this file as `.env.production` and fill in your real values.
# Vite injects these at BUILD TIME — they are embedded in the JS bundle.
# NEVER put truly secret values here (they end up in client-side code).

# Backend API (your Lambda API Gateway URL + /api/v1)
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/api/v1

# API Key (shared with backend for X-API-Key header)
VITE_API_KEY=your-api-key

# Supabase (anon key only — safe for client-side) — still used for all data
# (businesses, brand_memory, scheduled_posts, generated_content); auth moved
# to Firebase below.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase (authentication only — see FIREBASE_AUTH_MIGRATION.md)
# Firebase Console → Project settings → General → Your apps → Web app config.
# These are NOT secret — safe to ship in client-side code by design.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
